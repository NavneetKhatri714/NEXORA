generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum SourceType {
  RESUME
  GITHUB
  LINKEDIN
  MANUAL
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum ProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model User {
  id           String        @id @default(cuid())
  name         String
  email        String        @unique
  passwordHash String
  targetRole   String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  profile      Profile?
  skills       UserSkill[]
  roadmaps     Roadmap[]
  assessments  Assessment[]
  projects     Project[]
  progress     Progress[]
}

model Profile {
  id             String   @id @default(cuid())
  userId         String   @unique
  githubUsername String?
  linkedinUrl    String?
  resumeText     String?
  resumeFile     String?
  source         SourceType?
  extractedData  Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Skill {
  id             String        @id @default(cuid())
  name           String        @unique
  category       String?
  description    String?
  userSkills     UserSkill[]
  roadmapSkills  RoadmapSkill[]
  requiredSkills RequiredSkill[]
  createdAt      DateTime      @default(now())
}

model UserSkill {
  id        String     @id @default(cuid())
  userId    String
  skillId   String
  level     SkillLevel @default(BEGINNER)
  score     Float      @default(0)
  source    SourceType @default(MANUAL)
  evidence  String?
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill     Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
}

model CareerRole {
  id             String          @id @default(cuid())
  name           String          @unique
  description    String?
  requiredSkills RequiredSkill[]
  roadmaps       Roadmap[]
}

model RequiredSkill {
  id       String     @id @default(cuid())
  roleId   String
  skillId  String
  level    SkillLevel
  weight   Float      @default(1)
  role     CareerRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  skill    Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([roleId, skillId])
}

model Roadmap {
  id          String         @id @default(cuid())
  userId      String
  roleId      String?
  title       String
  summary     String?
  aiGenerated Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  role        CareerRole?    @relation(fields: [roleId], references: [id])
  skills      RoadmapSkill[]
  projects    Project[]
  progress    Progress[]
}

model RoadmapSkill {
  id         String     @id @default(cuid())
  roadmapId  String
  skillId    String
  target     SkillLevel
  priority   Int        @default(1)
  courseUrl  String?
  projectIdea String?
  roadmap    Roadmap    @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  skill      Skill       @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([roadmapId, skillId])
}

model Project {
  id          String         @id @default(cuid())
  userId      String
  roadmapId   String?
  title       String
  description String
  difficulty  SkillLevel     @default(INTERMEDIATE)
  githubUrl   String?
  status      ProgressStatus @default(NOT_STARTED)
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmap     Roadmap?       @relation(fields: [roadmapId], references: [id], onDelete: SetNull)
  createdAt   DateTime       @default(now())
}

model Assessment {
  id        String   @id @default(cuid())
  userId    String
  title     String
  skillName String
  questions Json
  score     Float?
  answers   Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Progress {
  id          String         @id @default(cuid())
  userId      String
  roadmapId   String?
  itemType   String
  itemId     String
  status     ProgressStatus @default(NOT_STARTED)
  score      Float?
  completedAt DateTime?
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmap     Roadmap?       @relation(fields: [roadmapId], references: [id], onDelete: SetNull)

  @@unique([userId, itemType, itemId])
}
